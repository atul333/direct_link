# ─────────────────────────────────────────────
#  Telegram Bot Configuration
# ─────────────────────────────────────────────
BOT_TOKEN=

# Comma-separated list of Telegram user IDs that are admins
# Example: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# ─────────────────────────────────────────────
#  Razorpay Configuration
# ─────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─────────────────────────────────────────────
#  Database
# ─────────────────────────────────────────────
DATABASE_PATH=bot_data.db

# ─────────────────────────────────────────────
#  Webhook Configuration (Auto-Approval)
# ─────────────────────────────────────────────
WEBHOOK_PORT=5000
RAZORPAY_WEBHOOK_SECRET=

# ─────────────────────────────────────────────
#  Bot Settings
# ─────────────────────────────────────────────
# Delay between broadcast messages in seconds (to respect Telegram rate limits)
BROADCAST_DELAY=0.05

# Default Main Channel where broadcast posts are sent (e.g. @MyMainChannel or -1001234567890)
MAIN_CHANNEL_ID=-

# Comma-separated list of mandatory channel IDs that users must join before using the bot
# Example: MANDATORY_CHANNELS=-1003833649347,-1003962377737,-1004296919279
MANDATORY_CHANNELS=-1003833649347,-1003962377737,-1004296919279
